# Banco MySQL/MariaDB do proprio cPanel (obrigatorio)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanelprefix_rp_instituto
DB_USER=cpanelprefix_rp_instituto_app
DB_PASSWORD=replace-with-a-strong-password
DB_CONNECTION_LIMIT=10
CPANEL_DEPLOY=true

# Autenticacao e criptografia locais (obrigatorio)
# Gere cada segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-random-hex-characters
ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Dominio
NEXT_PUBLIC_SITE_URL=https://rp-instituto.example
NEXT_PUBLIC_APP_URL=https://rp-instituto.example
CANONICAL_APP_URL=https://rp-instituto.example
APP_URL=https://rp-instituto.example
NEXT_PUBLIC_APP_LOCALE=pt
ALLOWED_INVITE_HOSTS=rp-instituto.example

# Ficheiros persistentes no cPanel
LOCAL_UPLOAD_DIR=/home/CPANEL_USER/data/whatsappcrm/uploads

# Email local do dominio (necessario para recuperar senha)
SMTP_HOST=mail.rp-instituto.example
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RP Instituto de Beleza <geral@rp-instituto.example>"

# Cron
AUTOMATION_CRON_SECRET=replace-with-another-long-random-secret

# WhatsApp Business Cloud API (opcional; QR local nao precisa destas variaveis)
META_APP_SECRET=
META_APP_ID=
WHATSAPP_TEMPLATES_DRY_RUN=false

# SumUp: checkout online hospedado e reconciliação automática (opcional)
# Crie a chave no SumUp Dashboard > Developer Settings. Nunca a coloque no browser.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Bridge QR no computador (opcional; evita Chromium no cPanel)
WHATSAPP_MODE=remote_worker
WHATSAPP_WORKER_URL=https://your-free-tunnel.example
WHATSAPP_WORKER_SECRET=replace-with-a-shared-random-secret
# Telemóvel do proprietário que recebe os alertas operacionais (formato internacional)
ADMIN_WHATSAPP_PHONE=+351900000000

# Web Push (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rp-instituto.example
PUSH_WEBHOOK_SECRET=

# IA (opcional; as chaves dos provedores sao guardadas criptografadas no banco)
AI_REQUEST_TIMEOUT_MS=30000
AI_CONTEXT_MESSAGE_LIMIT=20
