{
  "name": "rp-instituto-de-beleza-crm",
  "version": "0.8.0",
  "private": true,
  "description": "Self-hosted WhatsApp CRM built on Next.js and MySQL/MariaDB.",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "homepage": "https://github.com/ArnasDon/wacrm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArnasDon/wacrm.git"
  },
  "bugs": {
    "url": "https://github.com/ArnasDon/wacrm/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "nextjs",
    "mysql",
    "automation",
    "broadcast",
    "self-hosted",
    "template"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cpanel": "next build --webpack",
    "deploy:cpanel": "node scripts/cpanel-deploy.mjs",
    "start": "next start",
    "start:cpanel": "node server.cjs",
    "postinstall": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(process.env.INIT_CWD||process.cwd(),'scripts/cpanel-postinstall.mjs')).href)\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:whatsapp:install": "npm install --prefix workers/whatsapp-bridge",
    "worker:whatsapp:start": "npm start --prefix workers/whatsapp-bridge",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:mysql": "node scripts/mysql-migrate.mjs",
    "db:audit:mysql": "node scripts/audit-mysql-schema.mjs"
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.107.0",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jimp": "^0.16.13",
    "jspdf": "^4.2.1",
    "link-preview-js": "^3.2.0",
    "lucide-react": "^1.22.0",
    "mysql2": "^3.24.2",
    "next": "16.2.6",
    "next-intl": "^4.13.1",
    "nodemailer": "^9.0.5",
    "opus-recorder": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.30.7",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip-address": "^10.1.1",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.25",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6"
  }
}
